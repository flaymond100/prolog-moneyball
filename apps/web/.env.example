# Base path the app is served from: /prolog-moneyball/ on GitHub Pages, / for a custom domain.
VITE_BASE_PATH=/

# Supabase project URL and publishable key: the only Supabase values the client
# ever gets (CLAUDE.md). For the local stack, take both from `supabase status`.
# Leave them out to run the dev server on mock data with a role switcher; a
# production build without them shows "Not Configured" instead of the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
